{
  "name": "@ennel/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate --no-hints && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json",
    "test": "pnpm test:unit && vitest run -c vitest.integration.config.mts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "seed": "prisma db seed",
    "test:unit": "prisma generate --no-hints && vitest run",
    "test:integration": "prisma generate --no-hints && vitest run -c vitest.integration.config.mts"
  },
  "dependencies": {
    "@ennel/shared": "workspace:*",
    "@nestjs/common": "^11.2",
    "@nestjs/core": "^11.2",
    "@nestjs/jwt": "^11",
    "@nestjs/platform-express": "^11.2",
    "@nestjs/swagger": "^11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45",
    "csv-parse": "^7",
    "csv-stringify": "^6.9",
    "exceljs": "^4.4",
    "ioredis": "^5.11",
    "reflect-metadata": "^0.2",
    "rxjs": "^7.8",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11.2",
    "@swc/core": "^1",
    "@types/express": "^5",
    "@types/multer": "^2",
    "@types/supertest": "^6",
    "prisma": "7.10.1",
    "supertest": "^7",
    "tsx": "^4",
    "unplugin-swc": "^2",
    "vitest": "^4.1"
  }
}
