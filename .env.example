# Copy to .env (never commit .env). Values below are for local development only.
NODE_ENV=development
API_PORT=3000

# docker-compose.dev.yml
DATABASE_URL=postgresql://ennel:ennel@localhost:5432/ennel?schema=public
# Separate DB used by integration tests
TEST_DATABASE_URL=postgresql://ennel:ennel@localhost:5432/ennel_test?schema=public
REDIS_URL=redis://localhost:6379

# Different secrets and audiences for students and staff (ADR-0015). Use 32+ random chars.
JWT_STUDENT_SECRET=change-me-student-secret-at-least-32-chars
JWT_STAFF_SECRET=change-me-staff-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 32-byte key, base64, for encrypting staff TOTP secrets
TOTP_ENCRYPTION_KEY=

# Local file storage for complaint photos and import files
STORAGE_DIR=./storage

# Admin web origin allowed by CORS
ADMIN_WEB_ORIGIN=http://localhost:5173

# First Super Admin, created by the seed only (Admin §B). Must change password on first login.
SEED_SUPER_ADMIN_EMAIL=admin@ennel.local
SEED_SUPER_ADMIN_NAME=ENNEL Super Admin
SEED_SUPER_ADMIN_PASSWORD=
